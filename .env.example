NEXT_PUBLIC_SITE_URL=https://infratek.vn
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=trong.ngo@infratek.vn
RESEND_API_KEY=re_xxxxxxxxxx
CONTACT_RECIPIENT=contact@example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
DATABASE_URL_PREVIEW_UNPOOLED=postgresql://USER:PASSWORD@PREVIEW_DIRECT_HOST/DATABASE?sslmode=require
DATABASE_URL_PRODUCTION_UNPOOLED=postgresql://USER:PASSWORD@PRODUCTION_DIRECT_HOST/DATABASE?sslmode=require
# Required only while executing a Production write migration:
CONFIRM_PRODUCTION_MIGRATION=
PAYLOAD_SECRET=replace-with-a-long-random-secret
PAYLOAD_ADMIN_EMAIL=admin@example.com
PAYLOAD_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxx
CONTENT_SOURCE=payload
PAYLOAD_PREVIEW_SECRET=replace-with-a-separate-long-random-secret
INTERNAL_SERVICE_SECRET=replace-with-a-separate-long-random-secret

# Phase 5 chatbot — build-safe configuration (no real secrets)
CHAT_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-2-preview
EMBED_DIMENSION=768
CHAT_MODEL_VERSION=gemini-3.5-flash-lite-p5.1
EMBED_VERSION=gemini-embedding-2-preview-768-p5.1
PROMPT_VERSION=p5.1
THRESHOLD_VERSION=UN-CALIBRATED
INGESTION_VERSION=p5.1
CHAT_PER_MINUTE=6
CHAT_IP_DAILY_CAP=50
CHAT_SESSION_CAP=30
CHAT_DAILY_CAP=150
CHAT_INPUT_MAX_LENGTH=500
CHAT_CONTEXT_MESSAGES=6
CHAT_OUTPUT_MAX_TOKENS=256
CHAT_CONVERSATION_RETENTION_DAYS=30
CHAT_UNANSWERED_RETENTION_DAYS=90
CHAT_FEEDBACK_RETENTION_DAYS=90

# Phase 5 chatbot — runtime-only secret; required only when provider calls begin.
GOOGLE_GENERATIVE_AI_API_KEY=
